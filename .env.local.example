# Instagram Graph API
# Necessário para exibir os posts reais na seção "Siga no Instagram"
#
# Como obter:
# 1. Converta a conta @vintage.drumshop para Business ou Creator no app do Instagram
# 2. Acesse developers.facebook.com e crie um App (tipo "Business")
# 3. Adicione o produto "Instagram" ao app
# 4. Gere um access token com a permissão "instagram_graph_user_media"
# 5. Troque por um token de longa duração (válido por 60 dias):
#    GET https://graph.facebook.com/v18.0/oauth/access_token
#      ?client_id=SEU_APP_ID&client_secret=SEU_APP_SECRET
#      &grant_type=fb_exchange_token&fb_exchange_token=TOKEN_CURTO
# 6. Para obter o INSTAGRAM_USER_ID:
#    GET https://graph.facebook.com/v18.0/me?fields=id&access_token=SEU_TOKEN
#
# Lembre de renovar o token a cada ~55 dias.

INSTAGRAM_ACCESS_TOKEN=seu_token_aqui
INSTAGRAM_USER_ID=id_numerico_da_conta
